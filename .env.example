# Copy to `.env` and fill with real values (do NOT commit `.env`).
#
# Django
DJANGO_SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=our-way.jkproduction.pro,localhost,127.0.0.1

# Database
# Prefer `DATABASE_URL` to avoid escaping issues with special characters.
USE_SQLITE=False
DATABASE_URL=postgres://user:password@host:5432/dbname
# Alternative DB_* variables (used only if DATABASE_URL is empty):
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Our_Way
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# CORS / CSRF
CORS_ALLOW_ALL=False
CORS_ALLOWED_ORIGINS=https://our-way.jkproduction.pro,https://our-way.jkproduction.pro:443
CSRF_TRUSTED_ORIGINS=https://our-way.jkproduction.pro,https://our-way.jkproduction.pro:443,https://our-way.jkproduction.pro:8000
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# Reverse proxy support
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# One-time maintenance (DANGEROUS): wipe DB schema on container start
#RESET_DB=1

# Optional: skip boot-time tasks
#SKIP_MIGRATIONS=1
#SKIP_COLLECTSTATIC=1

# Optional: override base images for Docker builds (Dokploy Compose build args)
# Examples:
# PYTHON_BASE_IMAGE=registry-1.docker.io/library/python:3.11-slim
# FRONTEND_BASE_IMAGE=registry-1.docker.io/library/python:3.11-slim
# Or your private/mirror registry:
# PYTHON_BASE_IMAGE=registry.example.com/library/python:3.11-slim
# FRONTEND_BASE_IMAGE=registry.example.com/library/python:3.11-slim
#PYTHON_BASE_IMAGE=
#FRONTEND_BASE_IMAGE=
