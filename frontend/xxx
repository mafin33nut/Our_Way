[Unit]
Description=Bun static server for Our_Way frontend
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/ourway/frontend
ExecStart=/usr/local/bin/bun run server.js
Restart=on-failure
Environment=NODE_ENV=production
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
